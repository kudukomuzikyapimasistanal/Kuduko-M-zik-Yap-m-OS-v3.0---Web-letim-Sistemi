{
  "name": "kuduko-os",
  "version": "1.0.0",
  "description": "Kuduko OS masaüstü uygulaması",
  "main": "main.js",
  "author": "Kuduko",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:setup": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kuduko.os",
    "productName": "Kuduko OS",
    "files": ["main.js", "index.html", "icon.png"],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": { "output": "dist" }
  }
}
